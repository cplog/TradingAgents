# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
# NVIDIA NIM (build.nvidia.com): OpenAI-compatible chat at integrate.api.nvidia.com/v1
# so routes without tool support still work. Pick models/providers per https://openrouter.ai/docs
MOONSHOT_API_KEY=
KIMI_CODE_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1
# Optional aliases for Ollama behind Cloudflare or other API gateways.
# If set, OLLAMA_CF_URL is used only when OLLAMA_BASE_URL is unset.
# OLLAMA_CF_TOKEN is sent as the OpenAI-compatible bearer token.
#OLLAMA_CF_URL=https://your-ollama-gateway.example.com/v1
#OLLAMA_CF_TOKEN=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# Set provider and both models together (e.g. ollama-remote + gpt-5.4 is invalid and
# was previously logged verbatim in run provenance). The API now auto-corrects mismatches.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
# LangGraph checkpoint/resume for API jobs (enabled by default; set false to disable).
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
# When true (default), market-data tries yfinance before Alpha Vantage even if config lists AV first.
#TRADINGAGENTS_PREFER_FREE_DATA_VENDORS=
# Optional: Finnhub free tier (https://finnhub.io) — extra OHLCV + company/general news fallbacks.
#FINNHUB_API_KEY=
# News also uses Google News RSS (no key; respect feed ToS) and, with china-data, AKShare Eastmoney headlines.
# Mainland A-share + HK + US daily bars (optional): pip install 'tradingagents[china-data]' (AKShare + BaoStock).

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# Set provider and both models together (e.g. ollama-remote + gpt-5.4 is invalid and
# was previously logged verbatim in run provenance). The API now auto-corrects mismatches.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
# LangGraph checkpoint/resume for API jobs (enabled by default; set false to disable).
#TRADINGAGENTS_CHECKPOINT_ENABLED=false
#TRADINGAGENTS_PREFER_FREE_DATA_VENDORS=

# Service / API mode config  (all keys use TRADINGAGENTS_ prefix)
TRADINGAGENTS_LLM_PROVIDER=openrouter
TRADINGAGENTS_DEEP_THINK_LLM=openrouter/free
TRADINGAGENTS_QUICK_THINK_LLM=openrouter/free
TRADINGAGENTS_LLM_BACKEND_URL=https://openrouter.ai/api/v1
TRADINGAGENTS_MAX_CONCURRENCY=3
TRADINGAGENTS_JOB_TTL_HOURS=24
# Wall-clock cap for a single API job (seconds). Default 7200 (2 hours).
#TRADINGAGENTS_JOB_TIMEOUT_SECONDS=7200
# Heartbeat warning when no graph step completes for this many seconds.
#TRADINGAGENTS_JOB_STUCK_SECONDS=900
# Per-LLM HTTP request timeout (seconds). Recommended for remote providers.
#TRADINGAGENTS_LLM_TIMEOUT_SECONDS=180
# Min seconds between KV snapshots for progress heartbeats (reduces Cloudflare KV 429).
#TRADINGAGENTS_JOB_PERSIST_INTERVAL_SEC=90
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_OPENROUTER_FREE_ONLY=true
#TRADINGAGENTS_BENCHMARK_TICKER=
#TRADINGAGENTS_OPENROUTER_FREE_ONLY=false
#TRADINGAGENTS_MAX_CONCURRENCY=3
#TRADINGAGENTS_JOB_TTL_HOURS=24

# Overnight monitor (/monitor): background US extended-hours scan → scan-mode jobs when score ≥ threshold.
# Requires AKShare for the coarse US drop scan (pip install akshare). Restart API after changing.
#TRADINGAGENTS_MONITOR_ENABLED=true
#TRADINGAGENTS_MONITOR_POLL_SECONDS=900
#TRADINGAGENTS_MONITOR_SIGNAL_THRESHOLD=75

# Options Strategist overlay (runs after Portfolio Manager, uses yfinance options chain).
# When enabled, the graph inserts an Options Strategist node that recommends concrete
# options strategies (spreads, iron condors, etc.) based on the PM rating + live IV data.
#TRADINGAGENTS_OPTIONS_STRATEGIST_ENABLED=false

# Web UX / API maintenance (optional)
#TRADINGAGENTS_ADMIN_KEY=
#TRADINGAGENTS_API_STATE_FILE=

# Cloudflare (same account + API token for KV and D1; use different resource IDs)
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_API_TOKEN=
#
# KV — StateStore only: admin secrets, service overrides, in-flight jobs (not analysis history when D1 is set).
#CLOUDFLARE_KV_NAMESPACE_ID=
#
# D1 — analysis history, /history sector filters, coverage run counts, peer universes.
# After D1 is set, run once: uv run python scripts/cold_start_yahoo_sectors.py --constituents
# Default markets: US (Yahoo industry lists) + HK (seed file + yfinance). API reads buckets from D1.
#CLOUDFLARE_D1_DATABASE_ID=
#
# TradingAgents data cache (news hot-board + optional OHLCV cache tables ta_*):
# - TRADINGAGENTS_DATA_CACHE_BACKEND=none | sqlite | d1
# - sqlite: uses TRADINGAGENTS_CACHE_DIR (or default ~/.tradingagents/cache) + ta_data_cache.db
# - d1: same CLOUDFLARE_* credentials as above; schema is created with API history bootstrap.
#TRADINGAGENTS_DATA_CACHE_BACKEND=sqlite
# Optional: persist OHLCV into ta_stock_bars after each successful get_stock_data (needs sqlite or d1).
#TRADINGAGENTS_DATA_CACHE_AUTO_STOCK_BARS=false
# Optional NewsNow-compatible hot-board base URL (GET {base}/api/s?id={source}):
#TRADINGAGENTS_HOT_NEWS_FEED_BASE_URL=

# ----- Kronos forecasting -------------------------------------------------
# Source: https://github.com/shiyu-coder/Kronos (vendored under vendor/kronos/)
# Pulled by scripts/dev_up.sh. Set KRONOS_ENABLED=false to skip.
KRONOS_ENABLED=true
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
# device: auto (mps→cuda→cpu) | mps | cuda | cpu
# Note: on Apple Silicon, set to "cpu" if you hit MPS-specific torch bugs.
KRONOS_DEVICE=auto
KRONOS_LOOKBACK=200
KRONOS_PRED_LEN=20
KRONOS_SAMPLE_COUNT=1
KRONOS_T=1.0
KRONOS_TOP_P=0.9
KRONOS_TIMEOUT_SECONDS=90
KRONOS_MAX_CONTEXT=512
